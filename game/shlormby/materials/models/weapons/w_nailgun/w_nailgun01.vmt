"VertexLitGeneric"
{
	"$basetexture"	"models\weapons\v_nailgun\v_nailgun"
	"$bumpmap" "models\weapons\v_nailgun\v_nailgun_normal"
	"$phongdisablehalflambert" "1"
	"$phong" "1"
	"$phongexponenttexture" "models\weapons\v_nailgun\v_nailgun_exponent"
	"$phongboost" "4"
	"$rimlight" "1"
	"$rimlightexponent" "5"	
	"$rimlightboost" "2"
	"$rimmask" "1"
	
	//"$lightwarptexture" "models\weapons\v_nailgun\v_nailgun_lightwarp"
	"$lightwarptexture" "models\lightwarps\weapon_lightwarp"
	
	"$phongfresnelranges"	"[.5 1.5 10]"

	"$commadd_phongexponent" "30"
	"$commadd_phongboost" 	"22.5"
	"$commweapon"		"0"

	"$tempvar" "0"

	"$glowcolor" "1"

	// Cloaking
	"$cloakPassEnabled" "1"
	
	"$yellow" "0"

    "Proxies"
    {
        "ConVarEx"
        {
             "ConVar" "tf2c_player_nohalflambert"
              "0"
                {
                     "$PhongDisableHalfLambert"  "0"
                }
               "1"
               {
                   "$PhongDisableHalfLambert"  "1"
               }
        }
		"invis"
		{
		}
		"ModelGlowColor"
		{
			"resultVar" "$glowcolor"
		}
		"Equals"
		{
			"srcVar1"  "$glowcolor"
			"resultVar" "$selfillumtint"
		}
		"Equals"
		{
			"srcVar1"  "$glowcolor"
			"resultVar" "$color2"
		}
		"YellowLevel"
		{
			"resultVar" "$yellow"
		}
		"Multiply"
		{
			"srcVar1" "$color2"
			"srcVar2" "$yellow"
			"resultVar" "$color2"
		}
	}
}
